class DaytonaRuntime:
    """
    Daytona runtime management for {{agent_name}} agent.
    
    Handles workspace creation, code execution, and runtime environment setup.
    """
    
    def __init__(self, config: Optional[Dict[str, Any]] = None):
        """
        Initialize Daytona runtime.
        
        Args:
            config: Optional configuration dictionary
        """
        # Get Daytona configuration from environment
        self.api_key = os.environ.get('DAYTONA_API_KEY')
        self.api_url = os.environ.get('DAYTONA_API_URL', 'https://app.daytona.io/api')
        self.target = os.environ.get('DAYTONA_TARGET', 'us')
        self.timeout = float(os.environ.get('DAYTONA_TIMEOUT', 30.0))
        
        # Merge any provided config
        self.config = config or {}
        
        # Daytona client setup
        self.client = None
        self.workspace = None
        
        # Initialize Daytona client
        self._initialize_client()
    
    def _initialize_client(self):
        """
        Initialize Daytona client with configuration.
        """
        try:
            if not self.api_key:
                raise ValueError("No Daytona API key found in environment")
            
            # Create Daytona configuration
            daytona_config = DaytonaConfig(
                api_key=self.api_key,
                server_url=self.api_url,
                target=self.target
            )
            
            # Create Daytona client
            self.client = Daytona(daytona_config)
            print("✅ Daytona client initialized successfully")
        
        except Exception as e:
            print(f"❌ Daytona initialization error: {e}")
            self.client = None
    
    def create_workspace(self, language: str = 'python'):
        """
        Create a new Daytona workspace.
        
        Args:
            language: Programming language for the workspace
        
        Returns:
            Workspace object
        """
        try:
            if not self.client:
                raise RuntimeError("Daytona client not initialized")
            
            # Create workspace parameters
            params = CreateWorkspaceParams(language=language)
            
            # Create workspace
            self.workspace = self.client.create(params)
            print(f"🚀 Created Daytona workspace: {self.workspace.id}")
            
            return self.workspace
        
        except Exception as e:
            print(f"❌ Workspace creation error: {e}")
            return None
    
    def upload_code(self, local_path: str, remote_path: str = '/home/daytona/agent'):
        """
        Upload code to the Daytona workspace.
        
        Args:
            local_path: Local path of the code to upload
            remote_path: Remote path in the workspace
        
        Returns:
            bool: Success status
        """
        try:
            if not self.workspace:
                raise RuntimeError("No active workspace")
            
            # Ensure remote directory exists
            self.workspace.process.exec(f"mkdir -p {remote_path}")
            
            # Walk through local directory and upload files
            for root, dirs, files in os.walk(local_path):
                for file in files:
                    # Skip certain file types
                    if file.endswith(('.pyc', '.pyo', '.log')):
                        continue
                    
                    # Construct full local and remote paths
                    local_file = os.path.join(root, file)
                    relative_path = os.path.relpath(local_file, local_path)
                    remote_file = os.path.join(remote_path, relative_path)
                    
                    # Create remote directory if needed
                    remote_dir = os.path.dirname(remote_file)
                    self.workspace.process.exec(f"mkdir -p {remote_dir}")
                    
                    # Read and upload file
                    with open(local_file, 'rb') as f:
                        content = f.read()
                        self.workspace.fs.upload_file(remote_file, content)
                    
                    print(f"📤 Uploaded: {local_file} → {remote_file}")
            
            return True
        
        except Exception as e:
            print(f"❌ Code upload error: {e}")
            return False
    
    def execute_command(self, command: str):
        """
        Execute a command in the Daytona workspace.
        
        Args:
            command: Command to execute
        
        Returns:
            Command execution result
        """
        try:
            if not self.workspace:
                raise RuntimeError("No active workspace")
            
            # Execute command
            result = self.workspace.process.exec(command)
            print(f"🔧 Executed: {command}")
            return result
        
        except Exception as e:
            print(f"❌ Command execution error: {e}")
            return None
    
    def cleanup(self):
        """
        Clean up and remove the Daytona workspace.
        """
        try:
            if self.workspace:
                self.client.remove(self.workspace)
                print("🧹 Workspace cleaned up")
                self.workspace = None
        
        except Exception as e:
            print(f"❌ Workspace cleanup error: {e}")


