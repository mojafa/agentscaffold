        except ImportError:
            self.logger.warning("Logfire package not installed. Run: pip install logfire")
        except Exception as e:
            self.logger.error(f"Logfire initialization error: {e}")
    
    async def _call_mcp(self, server_id, endpoint, data):
        """Call an MCP server."""
        if not self.mcp_config or "mcpServers" not in self.mcp_config:
            self.logger.error("MCP configuration not found or invalid")
            return None
        
        if server_id not in self.mcp_config["mcpServers"]:
            self.logger.error(f"Server {server_id} not found in MCP configuration")
            return None
        
        server_config = self.mcp_config["mcpServers"][server_id]
        server_url = server_config.get("url")
        
        if not server_url:
            self.logger.error(f"URL not found for server {server_id}")
            return None
        
        # Get authentication headers
        headers = {"Content-Type": "application/json"}
        
        # Handle authentication based on server config
        if "auth" in server_config:
            auth_config = server_config["auth"]
            auth_type = auth_config.get("type")
            
            if auth_type == "bearer":
                api_key = os.environ.get(auth_config.get("env_var"))
                if api_key:
                    headers["Authorization"] = f"Bearer {api_key}"
                    self.logger.info(f"Added Bearer token for {server_id}")
                else:
                    self.logger.warning(f"API key not found in environment variable {auth_config.get('env_var')}")
            
            elif auth_type == "api_key":
                api_key = os.environ.get(auth_config.get("env_var"))
                header_name = auth_config.get("header_name", "X-API-Key")
                
                if api_key:
                    headers[header_name] = api_key
                    self.logger.info(f"Added API key with header {header_name} for {server_id}")
                else:
                    self.logger.warning(f"API key not found in environment variable {auth_config.get('env_var')}")
        
        # Check for custom endpoints config
        if "endpoints" in server_config and endpoint in server_config["endpoints"]:
            # Use the custom endpoint path from the config
            endpoint_path = server_config["endpoints"][endpoint]
            
            # Create a copy of the data to avoid changing it during iteration
            data_copy = None
            if isinstance(data, dict):
                data_copy = data.copy()
            
            # Replace placeholders in the endpoint path if needed
            if "{" in endpoint_path and "}" in endpoint_path and data_copy:
                for key, value in data_copy.items():
                    placeholder = "{" + key + "}"
                    if placeholder in endpoint_path:
                        endpoint_path = endpoint_path.replace(placeholder, str(value))
                        # Remove from data since it's now in the URL
                        if key in data:
                            data.pop(key)
            
            url = f"{server_url.rstrip('/')}{endpoint_path}"
            self.logger.info(f"Using custom endpoint path for {endpoint}: {endpoint_path}")
        else:
            # Use standard endpoint path
            url = f"{server_url}/{endpoint.lstrip('/')}"
        
        # Special handling for search capability
        capability = server_config.get("capability", "").lower()
        if capability == "search" and isinstance(data, dict) and "query" in data:
            # For search, convert to query params and use GET
            params = {"q": data["query"]}
            if "count" in data:
                params["count"] = data["count"]
            
            self.logger.info(f"Sending search query: {params['q']}")
            
            try:
                async with httpx.AsyncClient(timeout=30.0, follow_redirects=True) as client:
                    self.logger.info(f"Calling search API at {url}")
                    
                    # Log headers (mask sensitive info)
                    safe_headers = {k: ("***" if k.lower() in ["authorization", "x-subscription-token", "x-api-key"] else v) for k, v in headers.items()}
                    self.logger.info(f"Request headers: {json.dumps(safe_headers)}")
                    
                    # Ensure the URL is correctly formed
                    url = url.rstrip('/')  # Remove any trailing slash
                    
                    # Use GET for search
                    response = await client.get(
                        url,
                        headers=headers,
                        params=params
                    )
                    
                    self.logger.info(f"Response status code: {response.status_code}")
                    
                    if response.status_code == 200:
                        return response.json()
                    else:
                        self.logger.error(f"Error from search API: {response.status_code} - {response.text}")
                        return {"error": f"Error {response.status_code}: {response.text}"}
            except Exception as e:
                self.logger.error(f"Error calling search API: {e}")
                return {"error": str(e)}
        
        # Standard POST request for other capabilities
        try:
            async with httpx.AsyncClient(timeout=30.0) as client:
                self.logger.info(f"Calling MCP server {server_id} at {url}")
                
                # Log headers (mask sensitive info)
                safe_headers = {k: ("***" if k.lower() in ["authorization", "x-subscription-token", "x-api-key"] else v) for k, v in headers.items()}
                self.logger.info(f"Request headers: {json.dumps(safe_headers)}")
                
                response = await client.post(
                    url,
                    headers=headers,
                    json=data
                )
                
                self.logger.info(f"Response status code: {response.status_code}")
                
                if response.status_code == 200:
                    return response.json()
                else:
                    self.logger.error(f"Error from MCP server: {response.status_code} - {response.text}")
                    return {"error": f"Error {response.status_code}: {response.text}"}
        except Exception as e:
            self.logger.error(f"Error calling MCP server: {e}")
            return {"error": str(e)}
            
    async def search(self, query: str) -> Optional[Dict[str, Any]]:
        """
        Call the search provider via MCP and return the search results.
        """
        # Use the MCP key "search" as configured in your MCP configuration
        if not self.mcp_config or "mcpServers" not in self.mcp_config or "search" not in self.mcp_config["mcpServers"]:
            self.logger.error("Search provider not configured in MCP")
            return {"error": "Search provider not configured"}

        try:
            self.logger.info(f"Searching for: {query}")
            
            # Call the search provider using the MCP system
            search_response = await self._call_mcp(
                "search",
                "search",  # This will use the custom endpoint from the config
                {"query": query, "count": 5}
            )
            
            if search_response:
                # Check if there's an error
                if isinstance(search_response, dict) and "error" in search_response:
                    self.logger.error(f"Search error: {search_response['error']}")
                    return search_response
                
                self.logger.info("Search successful")
                return search_response
            else:
                self.logger.error("No response from search provider")
                return {"error": "No response from search provider"}
        except Exception as e:
            self.logger.error(f"Error during search: {e}")
            return {"error": f"Search error: {str(e)}"}

    # Memory methods
    async def remember(self, text: str, metadata: Optional[Dict[str, Any]] = None) -> Optional[str]:
        """Store text in memory with optional metadata"""
        try:
            # Generate unique ID for the memory entry
            import hashlib
            memory_id = hashlib.md5(text.encode()).hexdigest()

            # Ensure we always have metadata
            if metadata is None:
                metadata = {
                    "type": "general",
                    "timestamp": datetime.now().isoformat()
                }

            # If we have direct ChromaDB access, use it
            if hasattr(self, 'memory_collection'):
                self.logger.debug("Using direct ChromaDB memory storage")
                try:
                    self.memory_collection.add(
                        documents=[text],
                        metadatas=[metadata],  # Now guaranteed to be non-empty
                        ids=[memory_id]
                    )
                    self.logger.info(f"Successfully stored memory with ID: {memory_id}")
                    return memory_id
                except Exception as e:
                    self.logger.error(f"ChromaDB storage failed: {e}")
                    return None

            # Fallback to MCP method
            if self.mcp_config and "mcpServers" in self.mcp_config and "chromadb" in self.mcp_config["mcpServers"]:
                self.logger.debug("Attempting MCP memory storage")
                response = await self._call_mcp(
                    "chromadb",
                    "add",
                    {
                        "collection_id": "my_agent_memory",
                        "ids": [memory_id],
                        "documents": [text],
                        "metadatas": [metadata]  # Now guaranteed to be non-empty
                    }
                )

                if response and "error" not in response:
                    self.logger.info(f"MCP memory storage successful: {memory_id}")
                    return memory_id
                else:
                    self.logger.error(f"MCP memory storage failed: {response}")
                    return None
            
            self.logger.warning("No memory provider available")
            return None
        except Exception as e:
            self.logger.error(f"Memory storage error: {e}")
            return None
    
    
    async def recall(self, query: str, n_results: int = 5) -> List[Dict[str, Any]]:
        """Retrieve memories matching the query"""
        try:
            # If we have direct ChromaDB access, use it
            if hasattr(self, 'memory_collection'):
                self.logger.debug("Using direct ChromaDB memory query")
                # Clean the query for better matching
                cleaned_query = query.replace("?", "").strip().lower()
                self.logger.info(f"Searching memory with cleaned query: {cleaned_query}")
                try:
                    results = self.memory_collection.query(
                        query_texts=[cleaned_query],  # Use cleaned query
                        n_results=n_results
                    )
                    
                    formatted_results = []
                    if results and 'documents' in results and len(results['documents']) > 0:
                        for doc, metadata in zip(results['documents'][0], results['metadatas'][0]):
                            formatted_results.append({
                                'text': doc,
                                'metadata': metadata
                            })
                    
                    self.logger.info(f"Retrieved {len(formatted_results)} memories")
                    return formatted_results
                except Exception as e:
                    self.logger.error(f"ChromaDB query failed: {e}")
                    return []

            # Fallback to MCP method
            if self.mcp_config and "mcpServers" in self.mcp_config and "chromadb" in self.mcp_config["mcpServers"]:
                self.logger.debug("Attempting MCP memory query")
                cleaned_query = query.replace("?", "").strip().lower()
                response = await self._call_mcp(
                    "chromadb",
                    "query",
                    {
                        "collection_id": "my_agent_memory",
                        "query_texts": [cleaned_query],
                        "n_results": n_results
                    }
                )

                if response and "documents" in response:
                    self.logger.info("MCP memory query successful")
                    return response['documents']
                else:
                    self.logger.error(f"MCP memory query failed: {response}")
                    return []
            
            self.logger.warning("No memory provider available")
            return []
        except Exception as e:
            self.logger.error(f"Memory recall error: {e}")
            return []
     
    
   
    
    
    async def get_memory_context(self, query: str, n_results: int = 3) -> str:
        """
        Get formatted context from memory based on a query.
        
        Args:
            query: Query text
            n_results: Number of results to include
            
        Returns:
            Formatted context string
        """
        try:
            # Get memories
            memories = await self.recall(query, n_results=n_results)
            
            if not memories:
                return ""
            
            # Format the context
            context = f"Relevant context from memory for '{query}':\n\n"
            for i, memory in enumerate(memories, 1):
                context += f"{i}. {memory['text']}\n"
                
                # Add metadata timestamp if available
                if memory.get('metadata') and memory['metadata'].get('timestamp'):
                    timestamp = memory['metadata']['timestamp']
                    context += f"   Timestamp: {timestamp}\n"
                    
                context += "\n"
                
            return context
            
        except Exception as e:
            self.logger.error(f"Error getting memory context: {e}")
            return ""
    
    
    async def run(self, input_text: str, **kwargs) -> str:
        """
        Run the agent with the given input.
        
        Args:
            input_text: Input text to process
            **kwargs: Additional parameters
            
        Returns:
            Agent response
        """
        # Check for memory commands
        input_text = input_text.strip()
        if input_text.lower().startswith("remember "):
            # Extract the text to remember
            text = input_text[len("remember "):].strip()
            if not text:
                return "Please provide text to remember."
                
            # Add default metadata with timestamp for explicit memories
            default_metadata = {
                "type": "explicit_memory",
                "timestamp": datetime.now().isoformat()
            }
            
            memory_id = await self.remember(text, default_metadata)
            if memory_id:
                return f"I've stored that in memory with ID: {memory_id}"
            else:
                return "I wasn't able to store that in memory."
                
        elif input_text.lower().startswith("recall "):
            # Extract the query
            query = input_text[len("recall "):].strip()
            if not query:
                return "Please provide a query to recall from memory."
                
            memories = await self.recall(query)
            
            if memories:
                response = f"Here's what I found in memory for '{query}':\n\n"
                for i, memory in enumerate(memories, 1):
                    response += f"{i}. {memory['text']}\n"
                    
                    # Add metadata timestamp if available
                    if memory.get('metadata') and memory['metadata'].get('timestamp'):
                        timestamp = memory['metadata']['timestamp']
                        response += f"   Timestamp: {timestamp}\n"
                        
                    response += "\n"
                    
                return response
            else:
                return f"I couldn't find anything in memory related to '{query}'."
        
        elif input_text.lower() == "debug memory":
            try:
                if hasattr(self, 'memory_collection'):
                    # Get all items in the collection (limited to first 10)
                    results = self.memory_collection.peek(limit=10)
                    if not results or not results.get('documents'):
                        return "Memory is empty."
                        
                    response = "Current memory contents:\n\n"
                    for i, (doc, metadata) in enumerate(zip(results['documents'], results['metadatas']), 1):
                        response += f"{i}. {doc[:100]}{'...' if len(doc) > 100 else ''}\n"
                        if metadata:
                            response += f"   Metadata: {json.dumps(metadata)}\n"
                        response += "\n"
                        
                    return response
                else:
                    return "Memory collection not available."
            except Exception as e:
                return f"Error debugging memory: {str(e)}"
                
        elif input_text.lower() == "reset memory":
            try:
                if hasattr(self, 'memory_client'):
                    # Delete and recreate collection
                    collection_name = os.environ.get("CHROMADB_COLLECTION", "my_agent_memory")
                    try:
                        self.memory_client.delete_collection(collection_name)
                    except:
                        pass
                    self.memory_collection = self.memory_client.create_collection(name=collection_name)
                    return "Memory collection has been reset."
                else:
                    return "Memory client not available."
            except Exception as e:
                return f"Error resetting memory: {str(e)}"
        
        # Check if the input is a direct search command
        elif input_text.lower().startswith("search "):
            # Extract the search query by removing the "search " prefix
            query = input_text[len("search "):].strip()
            self.logger.info(f"Direct search command detected, searching for: {query}")
            search_results = await self.search(query)
            
            if search_results:
                # Check if there's an error message
                if "error" in search_results:
                    return f"Search error: {search_results['error']}"
                    
                # Format the search results for readability
                try:
                    # Ensure we're handling JSON correctly
                    if isinstance(search_results, str):
                        # Try to parse if it's a string
                        search_results = json.loads(search_results)
                    
                    # Simplified result formatting
                    if "web" in search_results and "results" in search_results["web"]:
                        results = search_results["web"]["results"]
                        formatted_results = []
                        
                        for i, result in enumerate(results[:5], 1):  # Limit to top 5 results
                            title = result.get("title", "No title")
                            url = result.get("url", "No URL")
                            description = result.get("description", "No description")
                            
                            formatted_results.append(f"{i}. {title}\n   URL: {url}\n   {description}\n")
                        
                        if formatted_results:
                            return "Search Results:\n\n" + "\n".join(formatted_results)
                    
                    # If we can't format nicely, just return the full JSON
                    return f"Raw search results:\n{json.dumps(search_results, indent=2)}"
                except Exception as e:
                    self.logger.error(f"Error formatting search results: {e}")
                    return f"Error formatting search results: {str(e)}\n\nRaw results: {str(search_results)}"
            else:
                return "No search results found or search failed."

        # Add the message to conversation history
        self.conversation_history.append({"role": "user", "content": input_text})
        
        # Store the user message in memory
        user_metadata = {
            "role": "user", 
            "timestamp": datetime.now().isoformat(),
            "type": "conversation"
        }
        await self.remember(input_text, user_metadata)
        
        # If we have memory, try to get relevant context
        memory_context = ""
        if hasattr(self, 'memory') and self.memory:
            memory_context = await self.get_memory_context(input_text)
        
        # Prepare messages for LLM
        system_content = "You are a helpful assistant for the {{package_name}} agent."
        if memory_context:
            system_content += f"\n\n{memory_context}"
            
        messages = [
            {"role": "system", "content": system_content}
        ]
        messages.extend(self.conversation_history)
        
        # Send request via MCP if configured for OpenAI
        try:
            
            if self.mcp_config and "mcpServers" in self.mcp_config and "openai-llm" in self.mcp_config["mcpServers"]:
                self.logger.info("Using MCP OpenAI provider")
                mcp_response = await self._call_mcp(
                    "openai-llm", 
                    "chat", 
                    {
                        "model": self.model,
                        "messages": messages,
                        "temperature": 0.7
                    }
                )
                
                if mcp_response and "choices" in mcp_response:
                    response_text = mcp_response["choices"][0]["message"]["content"]
                    self.conversation_history.append({"role": "assistant", "content": response_text})
                    
                    # Store the assistant response in memory
                    assistant_metadata = {
                        "role": "assistant", 
                        "timestamp": datetime.now().isoformat(),
                        "type": "conversation"
                    }
                    await self.remember(response_text, assistant_metadata)
                    
                    return response_text
                else:
                    self.logger.warning("MCP call failed, falling back to direct API call")
            
            else:
                self.logger.warning("MCP not configured for LLM, using direct API call")
        except Exception as e:
            self.logger.error(f"Error with MCP: {e}")
        
        # Fall back to direct API call if MCP fails
        try:
            
            if hasattr(self, 'client'):
                response = self.client.chat.completions.create(
                    model=self.model,
                    messages=messages,
                    temperature=0.7
                )
                
                response_text = response.choices[0].message.content
                self.conversation_history.append({"role": "assistant", "content": response_text})
                
                # Store the assistant response in memory
                assistant_metadata = {
                    "role": "assistant", 
                    "timestamp": datetime.now().isoformat(),
                    "type": "conversation"
                }
                await self.remember(response_text, assistant_metadata)
                
                return response_text
            
            else:
                # Fallback to httpx request if client not available
                async with httpx.AsyncClient(timeout=30.0) as client:
                    
                    if self.api_key:
                        response = await client.post(
                            "https://api.openai.com/v1/chat/completions",
                            headers={
                                "Authorization": f"Bearer {self.api_key}",
                                "Content-Type": "application/json"
                            },
                            json={
                                "model": self.model,
                                "messages": messages,
                                "temperature": 0.7
                            }
                        )
                        
                        if response.status_code == 200:
                            data = response.json()
                            response_text = data["choices"][0]["message"]["content"]
                            self.conversation_history.append({"role": "assistant", "content": response_text})
                            
                            # Store the assistant response in memory
                            assistant_metadata = {
                                "role": "assistant", 
                                "timestamp": datetime.now().isoformat(),
                                "type": "conversation"
                            }
                            await self.remember(response_text, assistant_metadata)
                            
                            return response_text
                        else:
                            self.logger.error(f"Error from OpenAI API: {response.text}")
                            return f"Error from OpenAI API: {response.text}"
                    
                    else:
                        return "No API key configured for LLM provider"
        except Exception as e:
            self.logger.error(f"Error calling API directly: {e}")
            return f"Error: {str(e)}"
        
        return "No LLM provider configured"