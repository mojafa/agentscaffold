    def _load_env_vars(self):
        """Load environment variables from .env file."""
        try:
            from dotenv import load_dotenv
            env_file = '.env'
            if os.path.exists(env_file):
                load_dotenv(env_file)
                self.logger.info(f"Loaded environment variables from {env_file}")
        except ImportError:
            self.logger.warning("dotenv package not available")
    
    def _load_mcp_config(self):
        """Load MCP configuration from .mcp.json file."""
        mcp_file = '.mcp.json'
        try:
            if os.path.exists(mcp_file):
                with open(mcp_file, 'r') as f:
                    return json.load(f)
            else:
                self.logger.warning(f"MCP configuration file {mcp_file} not found")
                return None
        except Exception as e:
            self.logger.error(f"Error loading MCP configuration: {e}")
            return None
    
    def _init_chromadb_memory(self):
        """Initialize ChromaDB memory provider."""
        try:
            import chromadb
            
            self.logger.info("Initializing ChromaDB memory provider")
            
            # Get configuration from environment variables or defaults
            collection_name = os.environ.get("CHROMADB_COLLECTION", "{{package_name}}_memory")
            persist_dir = os.environ.get("CHROMADB_PERSIST_DIR", "./.chroma")
            
            # Initialize the client
            self.memory_client = chromadb.PersistentClient(path=persist_dir)
            
            # Get or create collection
            try:
                self.memory_collection = self.memory_client.get_collection(name=collection_name)
                self.logger.info(f"Using existing collection: {collection_name}")
            except:
                self.memory_collection = self.memory_client.create_collection(name=collection_name)
                self.logger.info(f"Created new collection: {collection_name}")
            
            # Set memory mode
            self.memory_mode = "direct"
            self.memory = True
            self.logger.info("Successfully initialized ChromaDB memory")
                
        except ImportError:
            self.logger.warning("ChromaDB package not available. Install with: pip install chromadb")
        except Exception as e:
            self.logger.error(f"Failed to initialize ChromaDB memory: {e}")
    
    def _init_logfire_logging(self):
        """Initialize LogFire logging provider."""
        try:
            import logfire
            
            # Fetch API key from environment
            logfire_api_key = os.environ.get('LOGFIRE_API_KEY')
            
            if not logfire_api_key:
                self.logger.warning("No Logfire API key found!")
