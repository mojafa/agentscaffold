[build-system]
requires = ["setuptools>=42", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_name }} - An AI agent built with AgentScaffold"
readme = "README.md"
authors = [
    {name = "{{ project_name }} Developer"}
]
requires-python = ">=3.9"
classifiers = [
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.9",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
]
dependencies = [
    "agentscaffold",
    {% if 'llm' in providers %}
        {% if providers.llm == 'openai' %}
            "openai",
        {% elif providers.llm == 'anthropic' %}
            "anthropic",
        {% endif %}
    {% endif %}
    
    {% if 'memory' in providers %}
        {% if providers.memory == 'chromadb' %}
        "chromadb",
        {% endif %}
    {% endif %}

    {% if 'search' in providers %}
        {% if providers.search == 'brave' %}
        "brave-search",
        {% endif %}
    {% endif %}

    {% if 'logging' in providers %}
        {% if providers.logging == 'logfire' %}
        "logfire",
        {% endif %}
    {% endif %}
    
    "python-dotenv",
]

[project.scripts]
{{ project_name.replace('-', '_') }} = "{{ package_name }}.cli:main"

[project.urls]
"Homepage" = "https://github.com/yourusername/{{ project_name }}"
"Bug Tracker" = "https://github.com/yourusername/{{ project_name }}/issues"

[tool.setuptools]
packages = ["{{ package_name }}", "{{ package_name }}.providers", "{{ package_name }}.providers.llm", "{{ package_name }}.providers.memory", "{{ package_name }}.providers.search", "{{ package_name }}.providers.logging"]

[tool.isort]
profile = "black"
line_length = 88

[tool.black]
line-length = 88
target-version = ['py39', 'py310', 'py311', 'py312']
include = '\.pyi?'

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = "test_*.py"